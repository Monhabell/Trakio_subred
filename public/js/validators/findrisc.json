{
  "id": "findrisc",
  "nombre": "Prueba FINDRISC - Tamizaje de Diabetes",
  "code": "FDR",
  "desc": "Tamizaje FINDRISC para detección de riesgo de diabetes u otras anormalidades de la regulación de glucosa — mayores de 18 años — Entorno Laboral",
  "entornos": ["laboral"],
  "rules": {

